+#if CONFIG_BOARD_TYPE_DAVINCI_AI04_C3
+bool Ota::ApplyAi04FirmwareManifest() {
+    std::string manifest_url = CONFIG_AI04_OTA_MANIFEST_URL;
+    if (manifest_url.empty()) {
+        ESP_LOGE(TAG, "AI04 PT-BR manifest URL is not configured");
+        return false;
+    }
+
+    // Do not forward the device ID, MAC address, activation headers, or
+    // system-information JSON to the static release host.  Those are needed
+    // only by the official XiaoZhi endpoint above.
+    auto network = Board::GetInstance().GetNetwork();
+    auto http = network->CreateHttp(0);
+    http->SetHeader("Accept", "application/json");
+    if (auto opened = http->Open("GET", manifest_url); !opened) {
+        ESP_LOGE(TAG, "Failed to open AI04 PT-BR manifest: %s", opened.error().ToString().c_str());
+        return false;
+    }
+
+    auto status_code = http->GetStatusCode();
+    if (!status_code) {
+        ESP_LOGE(TAG, "Failed to read AI04 manifest status: %s", status_code.error().ToString().c_str());
+        return false;
+    }
+    if (*status_code != 200) {
+        ESP_LOGE(TAG, "Failed to get AI04 PT-BR manifest, status code: %d", *status_code);
+        return false;
+    }
+
+    std::string data = http->ReadAll();
+    http->Close();
+    cJSON* root = cJSON_Parse(data.c_str());
+    if (root == NULL) {
+        ESP_LOGE(TAG, "Failed to parse AI04 PT-BR manifest");
+        return false;
+    }
+
+    cJSON* firmware = cJSON_GetObjectItem(root, "firmware");
+    cJSON* version = cJSON_IsObject(firmware) ? cJSON_GetObjectItem(firmware, "version") : NULL;
+    cJSON* url = cJSON_IsObject(firmware) ? cJSON_GetObjectItem(firmware, "url") : NULL;
+    const bool valid_https_url = cJSON_IsString(url) && url->valuestring != NULL &&
+        std::strncmp(url->valuestring, "https://", std::strlen("https://")) == 0;
+    const bool valid_version = cJSON_IsString(version) && version->valuestring != NULL &&
+        ParseVersion(version->valuestring).has_value();
+    if (!valid_version || !valid_https_url) {
+        ESP_LOGE(TAG, "AI04 PT-BR manifest has no valid numeric version and HTTPS firmware URL");
+        cJSON_Delete(root);
+        return false;
+    }
+
+    firmware_version_ = version->valuestring;
+    firmware_url_ = url->valuestring;
+    has_new_version_ = IsNewVersionAvailable(current_version_, firmware_version_);
+    cJSON* force = cJSON_GetObjectItem(firmware, "force");
+    if (cJSON_IsNumber(force) && force->valueint == 1) {
+        has_new_version_ = true;
+    }
+    ESP_LOGI(TAG, "AI04 PT-BR manifest version: %s", firmware_version_.c_str());
+    cJSON_Delete(root);
+    return true;
+}
+#endif
+
