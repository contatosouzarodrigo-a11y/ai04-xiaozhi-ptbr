new file mode 100644
index 0000000..30f6f69
--- /dev/null
+++ b/tools/ai04-installer/stock_layout.py
@@ -0,0 +1,169 @@
+#!/usr/bin/env python3
+"""Validate a stock DaVinci AI04 C3 flash layout without exposing NVS data.
+
+The first PT-BR USB migration must keep the factory partition map untouched.
+This helper validates that a full 8 MiB backup is the known AI04 layout and
+finds the *currently selected* OTA slot.  The installer then replaces only
+that app slot, so the board keeps its original bootloader, model partition,
+partition table, NVS backup and the other firmware slot.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import struct
+import sys
+import zlib
+from dataclasses import dataclass
+from pathlib import Path
+
+
+FLASH_SIZE = 8 * 1024 * 1024
+PARTITION_TABLE_OFFSET = 0x8000
+PARTITION_TABLE_LENGTH = 0xC00
+PARTITION_ENTRY_SIZE = 32
+PARTITION_MAGIC = 0x50AA
+PARTITION_MD5_MAGIC = 0xEBEB
+OTA_RECORD_SIZE = 32
+OTA_RECORD_OFFSETS = (0xD000, 0xE000)
+OTA_STATE_VALID = 2
+OTA_STATE_UNDEFINED = 0xFFFFFFFF
+
+
+class StockLayoutError(ValueError):
+    """The backup is not safe to use with the AI04 stock-layout migrator."""
+
+
+@dataclass(frozen=True)
+class Partition:
+    label: str
+    type: int
+    subtype: int
+    offset: int
+    size: int
+    flags: int
+
+
+EXPECTED_PARTITIONS = (
+    Partition("nvs", 0x01, 0x02, 0x9000, 0x4000, 0),
+    Partition("otadata", 0x01, 0x00, 0xD000, 0x2000, 0),
+    Partition("phy_init", 0x01, 0x01, 0xF000, 0x1000, 0),
+    Partition("model", 0x01, 0x82, 0x10000, 0xF0000, 0),
+    Partition("ota_0", 0x00, 0x10, 0x100000, 0x380000, 0),
+    Partition("ota_1", 0x00, 0x11, 0x480000, 0x380000, 0),
+)
+
+
+def _esp_crc32(data: bytes) -> int:
+    """CRC convention used by ESP-IDF's OTA-select records."""
+    return zlib.crc32(data, 0xFFFFFFFF) & 0xFFFFFFFF
+
+
+def _partition_table(backup: bytes) -> tuple[list[Partition], str]:
+    table = backup[PARTITION_TABLE_OFFSET : PARTITION_TABLE_OFFSET + PARTITION_TABLE_LENGTH]
+    if len(table) != PARTITION_TABLE_LENGTH:
+        raise StockLayoutError("backup does not contain the full partition table")
+
+    partitions: list[Partition] = []
+    found_md5 = False
+    for offset in range(0, len(table), PARTITION_ENTRY_SIZE):
+        magic = struct.unpack_from("<H", table, offset)[0]
+        if magic == 0xFFFF:
+            break
+        if magic == PARTITION_MD5_MAGIC:
+            if table[offset + 2 : offset + 16] != b"\xff" * 14:
+                raise StockLayoutError("partition-table MD5 record has an invalid header")
+            expected_digest = hashlib.md5(table[:offset]).digest()
+            if table[offset + 16 : offset + 32] != expected_digest:
+                raise StockLayoutError("partition-table MD5 validation failed")
+            found_md5 = True
+            break
+        if magic != PARTITION_MAGIC:
+            raise StockLayoutError(f"unexpected partition-table entry at 0x{offset:x}")
+
+        _, part_type, subtype, part_offset, size, raw_label, flags = struct.unpack_from(
+            "<HBBII16sI", table, offset
+        )
+        try:
+            label = raw_label.split(b"\0", 1)[0].decode("ascii")
+        except UnicodeDecodeError as exc:
+            raise StockLayoutError("partition table contains a non-ASCII label") from exc
+        partitions.append(Partition(label, part_type, subtype, part_offset, size, flags))
+
+    if not found_md5:
+        raise StockLayoutError("partition-table MD5 record is missing")
+    return partitions, hashlib.md5(table[: len(partitions) * PARTITION_ENTRY_SIZE]).hexdigest()
+
+
+def _active_ota_partition(backup: bytes, partitions: list[Partition]) -> tuple[int, Partition, int]:
+    ota_partitions = [part for part in partitions if part.type == 0x00 and 0x10 <= part.subtype <= 0x1F]
+    ota_partitions.sort(key=lambda item: item.subtype)
+    if len(ota_partitions) != 2:
+        raise StockLayoutError("stock AI04 layout must contain exactly two OTA app slots")
+
+    valid_records: list[tuple[int, int]] = []
+    for offset in OTA_RECORD_OFFSETS:
+        sequence, _label, state, crc = struct.unpack_from("<I20sII", backup, offset)
+        if sequence == 0xFFFFFFFF:
+            continue
+        if crc != _esp_crc32(struct.pack("<I", sequence)):
+            continue
+        if state not in (OTA_STATE_VALID, OTA_STATE_UNDEFINED):
+            continue
+        valid_records.append((sequence, offset))
+
+    if not valid_records:
+        raise StockLayoutError("no validated active OTA selection was found")
+    sequence, _record_offset = max(valid_records)
+    slot = (sequence - 1) % len(ota_partitions)
+    return slot, ota_partitions[slot], sequence
+
+
+def inspect_stock_layout(backup: bytes) -> dict[str, object]:
+    """Return a non-sensitive structural summary or raise StockLayoutError."""
+    if len(backup) != FLASH_SIZE:
+        raise StockLayoutError(f"expected a complete 8 MiB backup, got {len(backup)} bytes")
+
+    partitions, table_md5 = _partition_table(backup)
+    if tuple(partitions) != EXPECTED_PARTITIONS:
+        raise StockLayoutError("partition table does not match the verified DaVinci AI04 C3 8 MiB layout")
+
+    slot, partition, sequence = _active_ota_partition(backup, partitions)
+    return {
+        "format": 1,
+        "board": "davinci-ai04-c3-stock-8m",
+        "flash_size": FLASH_SIZE,
+        "partition_table_md5": table_md5,
+        "active_ota_slot": slot,
+        "active_ota_label": partition.label,
+        "active_ota_offset": f"0x{partition.offset:x}",
+        "active_ota_size": partition.size,
+        "active_ota_sequence": sequence,
+        "backup_sha256": hashlib.sha256(backup).hexdigest(),
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--backup", type=Path, required=True, help="complete 8 MiB flash dump")
+    parser.add_argument("--json", action="store_true", help="emit machine-readable structural metadata")
+    args = parser.parse_args(argv)
+
+    try:
+        result = inspect_stock_layout(args.backup.read_bytes())
+    except (OSError, StockLayoutError) as exc:
+        print(f"ERRO: {exc}", file=sys.stderr)
+        return 2
+
+    if args.json:
+        print(json.dumps(result, separators=(",", ":")))
+    else:
+        print("Layout AI04 original validado")
+        print(f"Slot OTA ativo: {result['active_ota_label']} ({result['active_ota_offset']})")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
