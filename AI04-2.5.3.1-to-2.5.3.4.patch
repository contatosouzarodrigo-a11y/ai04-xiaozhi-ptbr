new file mode 100644
index 0000000..ee267d0
--- /dev/null
+++ b/tools/ai04-installer/test_stock_layout.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Focused regression tests for the AI04 stock-layout validator."""
+
+from __future__ import annotations
+
+import hashlib
+import struct
+import unittest
+import zlib
+
+from stock_layout import EXPECTED_PARTITIONS, PARTITION_ENTRY_SIZE, inspect_stock_layout
+
+
+def esp_crc32(data: bytes) -> int:
+    return zlib.crc32(data, 0xFFFFFFFF) & 0xFFFFFFFF
+
+
+def make_backup() -> bytearray:
+    image = bytearray(b"\xff" * (8 * 1024 * 1024))
+    table = bytearray(b"\xff" * 0xC00)
+    for index, part in enumerate(EXPECTED_PARTITIONS):
+        struct.pack_into(
+            "<HBBII16sI",
+            table,
+            index * PARTITION_ENTRY_SIZE,
+            0x50AA,
+            part.type,
+            part.subtype,
+            part.offset,
+            part.size,
+            part.label.encode("ascii").ljust(16, b"\0"),
+            part.flags,
+        )
+    md5_offset = len(EXPECTED_PARTITIONS) * PARTITION_ENTRY_SIZE
+    struct.pack_into("<H", table, md5_offset, 0xEBEB)
+    table[md5_offset + 16 : md5_offset + 32] = hashlib.md5(table[:md5_offset]).digest()
+    image[0x8000 : 0x8C00] = table
+
+    for record_offset, sequence in ((0xD000, 1), (0xE000, 2)):
+        struct.pack_into("<I20sII", image, record_offset, sequence, b"\xff" * 20, 2,
+                         esp_crc32(struct.pack("<I", sequence)))
+    return image
+
+
+class StockLayoutTests(unittest.TestCase):
+    def test_detects_active_ota_1(self) -> None:
+        result = inspect_stock_layout(make_backup())
+        self.assertEqual(result["active_ota_slot"], 1)
+        self.assertEqual(result["active_ota_label"], "ota_1")
+        self.assertEqual(result["active_ota_offset"], "0x480000")
+
+    def test_rejects_changed_partition_map(self) -> None:
+        backup = make_backup()
+        backup[0x8000 + 8] ^= 1
+        with self.assertRaisesRegex(ValueError, "partition-table MD5"):
+            inspect_stock_layout(backup)
+
+
+if __name__ == "__main__":
+    unittest.main()
